{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-eval-toolkit.local/schemas/workflow_config.schema.json",
  "title": "Agent Evaluation Workflow Configuration",
  "type": "object",
  "required": [
    "workflow_family",
    "workflow_definition_id",
    "source_schema",
    "event_type_map",
    "run_boundaries",
    "run_id_keys"
  ],
  "properties": {
    "workflow_family": {"type": "string", "minLength": 1},
    "workflow_definition_id": {"type": "string", "minLength": 1},
    "source_schema": {
      "type": "object",
      "required": ["event_id_field", "timestamp_field", "event_type_field"],
      "properties": {
        "event_id_field": {"type": "string", "minLength": 1},
        "timestamp_field": {"type": "string", "minLength": 1},
        "event_type_field": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "event_type_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "run_started", "step_started", "step_completed", "tool_call",
          "routing_decision", "handoff", "retry", "intervention",
          "quality_check", "run_completed", "run_failed", "unknown"
        ]
      }
    },
    "run_boundaries": {
      "type": "object",
      "required": ["start_event_type", "completed_event_type", "failed_event_type"],
      "properties": {
        "start_event_type": {"const": "run_started"},
        "completed_event_type": {"const": "run_completed"},
        "failed_event_type": {"const": "run_failed"}
      },
      "additionalProperties": false
    },
    "run_id_keys": {"$ref": "#/$defs/nonEmptyStringArray"},
    "trace_id_keys": {"$ref": "#/$defs/stringArray"},
    "step_name_keys": {"$ref": "#/$defs/stringArray"},
    "capture_raw_fields": {"$ref": "#/$defs/stringArray"},
    "metadata_fields": {"$ref": "#/$defs/stringArray"},
    "allowed_metadata_fields": {"$ref": "#/$defs/stringArray"},
    "restricted_fields": {"$ref": "#/$defs/stringArray"},
    "redact_raw_fields": {"$ref": "#/$defs/stringArray"},
    "evidence_mode": {
      "enum": ["anchor_hash_only", "anchor_hash_redacted_snapshot"]
    },
    "telemetry_capabilities": {
      "oneOf": [
        {"$ref": "#/$defs/stringArray"},
        {"type": "object", "additionalProperties": {"type": "boolean"}}
      ]
    },
    "aggregation_semantics": {
      "type": "object",
      "properties": {
        "observed_cost_usd": {"const": "per_event_increment"},
        "input_tokens": {"const": "per_event_increment"},
        "output_tokens": {"const": "per_event_increment"}
      },
      "additionalProperties": false
    },
    "business_success_field": {"type": "string", "minLength": 1},
    "human_effort_seconds_field": {"type": "string", "minLength": 1},
    "restricted_canaries": {
      "oneOf": [
        {"$ref": "#/$defs/stringArray"},
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"$ref": "#/$defs/nonEmptyStringArray"}
            ]
          }
        }
      ]
    },
    "restricted_value_canaries": {
      "$ref": "#/properties/restricted_canaries"
    },
    "redaction_canaries": {
      "$ref": "#/properties/restricted_canaries"
    },
    "privacy": {
      "type": "object",
      "properties": {
        "restricted_canaries": {"$ref": "#/properties/restricted_canaries"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
