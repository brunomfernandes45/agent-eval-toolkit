{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-eval-toolkit.local/schemas/evaluation_manifest.schema.json",
  "title": "Agent Evaluation Manifest",
  "type": "object",
  "required": [
    "evaluation_id", "evaluation_design", "measurement_window", "baseline",
    "comparator", "assumptions", "telemetry_requirements", "configuration",
    "taxonomy", "interpretation_boundaries"
  ],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "evaluation_design": {
      "enum": ["ab_test", "before_after", "monitoring", "scenario_suite", "staged_rollout"]
    },
    "measurement_window": {
      "type": "object",
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "baseline": {"$ref": "#/$defs/comparatorDefinition"},
    "comparator": {"$ref": "#/$defs/comparatorDefinition"},
    "assumptions": {"type": "object"},
    "telemetry_requirements": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {"$ref": "#/$defs/nonEmptyStringArray"},
        "optional": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "evidence_context": {
      "type": "object",
      "required": ["source_kind", "mapping_assessment_required"],
      "properties": {
        "source_kind": {
          "enum": ["synthetic_fixture", "benchmark", "enterprise_operational", "canonical_prevalidated"]
        },
        "mapping_assessment_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "publication_policy": {
      "type": "object",
      "required": ["minimum_evidence_tier"],
      "properties": {
        "minimum_evidence_tier": {"enum": ["mapping_only", "partial", "complete"]}
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": ["agent_configuration_id", "agent_version", "configuration_hash"],
      "properties": {
        "agent_configuration_id": {"type": "string", "minLength": 1},
        "agent_version": {"type": "string", "minLength": 1},
        "configuration_hash": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "expected_configurations": {
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/expectedConfiguration"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/expectedConfiguration"}
        }
      ]
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "deployment_mode", "workflow_integration", "autonomy_level", "hitl_pattern",
        "statefulness", "memory_strategy", "composition", "decomposition_strategy",
        "allocation_mechanism", "routing_strategy", "protocol_surfaces"
      ],
      "properties": {
        "protocol_surfaces": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": {"type": ["string", "array", "object", "number", "boolean", "null"]}
    },
    "interpretation_boundaries": {"$ref": "#/$defs/nonEmptyStringArray"},
    "inclusion_rules": {"$ref": "#/$defs/stringArray"},
    "exclusion_rules": {"$ref": "#/$defs/stringArray"},
    "concurrent_changes": {"$ref": "#/$defs/stringArray"},
    "run_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "reason"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "expectedConfiguration": {
      "type": "object",
      "required": ["agent_configuration_id", "agent_version", "configuration_hash"],
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "agent_configuration_id": {"type": "string", "minLength": 1},
        "agent_version": {"type": "string", "minLength": 1},
        "configuration_hash": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "comparatorDefinition": {
      "type": "object",
      "required": ["name", "type", "definition"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
