{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-eval-toolkit.local/schemas/source_profile.schema.json",
  "title": "Enterprise Source Profile",
  "type": "object",
  "required": [
    "source_profile_schema_version", "logical_source_id", "source_kind", "file_count",
    "record_count", "formats", "field_inventory", "manual_review_record_count"
  ],
  "properties": {
    "source_profile_schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "logical_source_id": {"type": "string", "minLength": 1},
    "source_kind": {"type": "string", "minLength": 1},
    "file_count": {"type": "integer", "minimum": 0},
    "record_count": {"type": "integer", "minimum": 0},
    "formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manual_review_record_count": {"type": "integer", "minimum": 0},
    "field_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "observed_count", "record_denominator", "coverage", "value_types"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "observed_count": {"type": "integer", "minimum": 0},
          "record_denominator": {"type": "integer", "minimum": 0},
          "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "value_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
